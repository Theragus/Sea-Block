# Versions the load test runs against. Bump these deliberately.
#
# The mod refs are branches rather than commits on purpose: this fork exists
# because upstream moved and Sea Block did not notice, so a CI failure caused by
# Bob's or Angel's changing again is information worth having early. The cost is
# that a pull request can go red without its own code changing — check the
# failure before assuming it is yours.
#
# To pin instead, replace a *_REF with a commit SHA.

FACTORIO_VERSION=2.1.19

FACTORIO_DATA_REPO=wube/factorio-data
FACTORIO_DATA_REF=master

BOBSMODS_REPO=modded-factorio/bobsmods
BOBSMODS_REF=dev2.1

ANGELS_REPO=Arch666Angel/mods
ANGELS_REF=dev2.1

SCT_REPO=mexmer/ScienceCostTweakerM
SCT_REF=dev2.1
